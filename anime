<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0f1226">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Anime">
<title>Meine Anime-Listen</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#0e1024;--panel:#181c3a;--line:#2b3160;--text:#eef0fb;--muted:#8d93bd;--accent:#ffb347;--danger:#ff6b81;--ok:#6ee7a8;--r:16px;--g1:#2a2470;--g2:#4a1d5c}
[data-theme=sakura]{--bg:#1a0f1c;--panel:#2b1a30;--line:#4a2a52;--accent:#ff7eb6;--g1:#5a1f4a;--g2:#2e1a5c}
[data-theme=mint]{--bg:#0a1a1c;--panel:#12292c;--line:#1f4a4c;--accent:#5eead4;--g1:#0f4a4a;--g2:#1c3a5c}
*{box-sizing:border-box}
body{margin:0;color:var(--text);font:16px/1.5 "Outfit","Trebuchet MS",system-ui,sans-serif;padding:32px 18px 80px;
  background:radial-gradient(900px 420px at 80% -10%,var(--g1) 0%,transparent 70%),radial-gradient(700px 400px at -10% 10%,var(--g2) 0%,transparent 65%),var(--bg);background-attachment:fixed}
main{max-width:1060px;margin:0 auto}
header{margin-bottom:18px}
h1{font-size:clamp(2rem,5vw,3rem);font-weight:800;margin:0;letter-spacing:-.02em;line-height:1.1;background:linear-gradient(90deg,#fff,var(--accent) 70%);-webkit-background-clip:text;background-clip:text;color:transparent}
.stats{color:var(--muted);margin:6px 0 0}
.sync{margin:2px 0 0;font-size:.85rem;color:var(--muted)}
.sync::before{content:"";display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--muted);margin-right:8px}
.sync.ok{color:var(--ok)}.sync.ok::before{background:var(--ok)}
.sync.bad{color:var(--danger)}.sync.bad::before{background:var(--danger)}
.themes{display:flex;gap:10px;margin-top:12px}
.themes button{width:20px;height:20px;border-radius:50%;border:2px solid var(--line);background:var(--c);cursor:pointer;padding:0}
.themes button.on{outline:2px solid var(--text);outline-offset:2px}

.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}
.tab{font:inherit;font-size:.95rem;color:var(--muted);background:rgba(24,28,58,.7);border:1px solid var(--line);border-radius:999px;padding:6px 16px;cursor:pointer}
.tab i{font-style:normal;color:var(--ok);margin-left:6px}
.tab:hover{color:var(--text)}
.tab.on{color:#2a1c00;background:var(--accent);border-color:var(--accent);font-weight:600}
.tab.on i{color:#2a1c00}
.tab.add{border-style:dashed}

.search{position:relative;margin-bottom:6px}
.search svg{position:absolute;left:16px;top:16px;width:20px;height:20px;stroke:var(--muted);fill:none;stroke-width:2;pointer-events:none}
.search input{width:100%;padding:15px 18px 15px 46px;font:inherit;color:var(--text);background:rgba(24,28,58,.8);backdrop-filter:blur(8px);border:2px solid var(--line);border-radius:999px;transition:border-color .2s,box-shadow .2s}
.search input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 5px color-mix(in srgb,var(--accent) 18%,transparent)}
.hint{color:var(--muted);font-size:.85rem;margin:6px 0 14px 18px;min-height:1.3em}
.sug{position:absolute;left:0;right:0;top:58px;z-index:10;background:var(--panel);border:2px solid var(--line);border-radius:var(--r);overflow:hidden;display:none;box-shadow:0 20px 50px rgba(0,0,0,.5)}
.sug button{display:flex;gap:14px;align-items:center;width:100%;text-align:left;background:none;border:0;color:var(--text);font:inherit;padding:8px 14px;cursor:pointer}
.sug button:hover,.sug button:focus{background:var(--line);outline:none}
.sug img{width:40px;height:58px;object-fit:cover;border-radius:6px;background:var(--line)}
.sug small{color:var(--muted)}

.bar{display:flex;gap:10px;flex-wrap:wrap;margin:0 0 22px;align-items:center}
.bar button,.panel button{font:inherit;font-size:.9rem;color:var(--text);background:rgba(24,28,58,.8);border:1px solid var(--line);border-radius:999px;padding:6px 16px;cursor:pointer}
.bar button:hover,.panel button:hover{border-color:var(--accent)}
.bar .pri,.panel .go{background:var(--accent);color:#2a1c00;border-color:var(--accent);font-weight:600}
.panel{background:rgba(24,28,58,.9);border:1px solid var(--line);border-radius:var(--r);padding:18px;margin:0 0 24px}
.panel p{margin:0 0 12px;color:var(--muted);font-size:.9rem}
.panel p.warn{margin:12px 0 0;font-size:.82rem}
.panel textarea,.panel input[type=text]{width:100%;font:inherit;font-size:.9rem;color:var(--text);background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:10px}
.panel textarea{resize:vertical}
.panel label{display:block;color:var(--muted);font-size:.85rem;margin:0 0 12px}
.panel label input{margin-top:4px}
.panel .row2{display:flex;gap:10px;align-items:center;margin-top:12px;flex-wrap:wrap}
.panel input[type=file]{color:var(--muted);font-size:.85rem;max-width:100%}
.panel ol{margin:0 0 12px 18px;padding:0;color:var(--muted);font-size:.9rem}
.panel summary{cursor:pointer;color:var(--text);margin-top:14px}
.panel pre{white-space:pre-wrap;word-break:break-word;font:inherit;font-size:.8rem;color:var(--muted);margin:10px 0 0}
.panel .msg{margin-top:10px;font-size:.88rem;color:var(--muted);word-break:break-word}
.panel .msg.bad{color:var(--danger)}
.panel .msg:empty{display:none}

.seg{display:flex;border:1px solid var(--line);border-radius:999px;overflow:hidden}
.bar .seg button{border:0;border-radius:0;background:var(--panel);color:var(--muted);padding:7px 18px}
.bar .seg button.on{background:var(--accent);color:#2a1c00;font-weight:600}

.hero{position:relative;display:flex;gap:28px;align-items:center;padding:26px;border-radius:24px;overflow:hidden;margin-bottom:34px;border:1px solid var(--line);isolation:isolate}
.hero::before{content:"";position:absolute;inset:-30px;background:var(--art) center/cover;filter:blur(36px) saturate(1.3);opacity:.55;z-index:-2}
.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(100deg,color-mix(in srgb,var(--bg) 82%,transparent),color-mix(in srgb,var(--bg) 35%,transparent));z-index:-1}
.hero .poster{flex:0 0 190px;aspect-ratio:2/3;border-radius:var(--r);overflow:hidden;box-shadow:0 18px 40px rgba(0,0,0,.55);background:var(--line);display:flex;align-items:center;justify-content:center;font-size:4rem;color:var(--muted)}
.hero .poster img{width:100%;height:100%;object-fit:cover;display:block}
.hero .txt{flex:1;min-width:230px}
.flag{display:inline-block;background:var(--accent);color:#2a1c00;font-weight:600;font-size:.85rem;padding:3px 12px;border-radius:999px;margin-bottom:10px}
.hero h2{font-size:clamp(1.5rem,4vw,2.4rem);line-height:1.15;margin:0 0 16px;font-weight:800}
.hero .tools{justify-content:flex-start;gap:18px;margin-top:10px}
.hero input[type=range]{max-width:340px}
.hero .scs{margin-bottom:14px}

h3{font-size:1.1rem;font-weight:600;color:var(--muted);margin:36px 0 14px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(176px,1fr));gap:18px}
.card{position:relative;aspect-ratio:2/3;border-radius:var(--r);overflow:hidden;background:var(--panel);box-shadow:0 8px 24px rgba(0,0,0,.35);transition:transform .2s,box-shadow .2s}
.card:hover{transform:translateY(-4px);box-shadow:0 16px 34px rgba(0,0,0,.5)}
.card .poster{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:3.5rem;color:var(--muted);background:var(--line)}
.card .poster img{width:100%;height:100%;object-fit:cover;display:block}
.rank{position:absolute;top:10px;left:10px;background:color-mix(in srgb,var(--bg) 80%,transparent);backdrop-filter:blur(6px);font-weight:800;border-radius:999px;padding:1px 11px;font-size:.95rem}
.rank.r2{background:#c9d1e8;color:#14172e}
.rank.r3{background:#d9a066;color:#2a1700}
.badge{position:absolute;top:10px;right:10px;width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:1.15rem;background:hsl(var(--h) 85% 58%);color:#14102a;box-shadow:0 4px 12px rgba(0,0,0,.4)}
.badge.none{background:color-mix(in srgb,var(--bg) 80%,transparent);color:var(--muted)}
.info{position:absolute;left:0;right:0;bottom:0;padding:44px 12px 10px;background:linear-gradient(to top,color-mix(in srgb,var(--bg) 97%,transparent) 35%,transparent)}
.title{font-weight:600;font-size:.95rem;line-height:1.25;margin:0 0 6px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.oth{display:flex;flex-wrap:wrap;gap:4px 10px;font-size:.78rem;color:var(--muted);margin-bottom:4px}
.oth b{color:hsl(var(--h) 85% 66%)}
.slw{max-height:0;opacity:0;overflow:hidden;transition:max-height .25s,opacity .2s}
.card:hover .slw,.card:focus-within .slw{max-height:150px;opacity:1}
@media (hover:none){.slw{max-height:150px;opacity:1}}
.tools{display:flex;flex-wrap:wrap;gap:2px 14px;margin-top:4px}
.tools .mv{color:var(--text)}
.tools button{background:none;border:0;color:var(--muted);font:inherit;font-size:.8rem;cursor:pointer;padding:2px 0}
.tools button:hover{color:var(--text)}
.tools .del:hover,.tools .del[data-arm]{color:var(--danger)}

.srow{display:flex;gap:22px;align-items:center;flex-wrap:wrap}
.sctl{flex:1;min-width:200px}
.ring{--p:calc(var(--s) * 10%);position:relative;flex:none;width:112px;height:112px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(hsl(var(--h) 85% 60%) var(--p),rgba(255,255,255,.14) 0)}
.ring::before{content:"";position:absolute;inset:9px;border-radius:50%;background:var(--bg)}
.ring output{position:relative;font-size:2.5rem;font-weight:800;line-height:1;color:hsl(var(--h) 85% 66%)}
.ring.sm{width:70px;height:70px}.ring.sm::before{inset:6px}.ring.sm output{font-size:1.25rem}

.ctl{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:8px}
.ctl .lab{color:var(--muted);font-size:.85rem}
.who{display:flex;gap:8px;flex-wrap:wrap}
.who button{font:inherit;font-size:.9rem;color:var(--muted);background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:5px 14px;cursor:pointer}
.who button.on{color:var(--text);border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}
.ctl .seg button{font:inherit;font-size:.9rem;color:var(--muted);background:var(--panel);border:0;padding:7px 18px;cursor:pointer}
.ctl .seg button.on{background:var(--accent);color:#2a1c00;font-weight:600}
.note{color:var(--muted);font-size:.9rem;margin:6px 0 26px}
.rows{display:grid;gap:12px}
.row{display:flex;flex-wrap:wrap;align-items:center;gap:14px;background:var(--panel);border-radius:var(--r);padding:10px 16px 10px 12px}
.row .rk{font-weight:800;font-size:1.2rem;color:var(--muted);min-width:2.4ch}
.row .pst{width:54px;height:78px;border-radius:8px;overflow:hidden;background:var(--line);flex:none}
.row .pst img{width:100%;height:100%;object-fit:cover;display:block}
.row .mid{flex:1;min-width:190px}
.row .nm{font-weight:600;margin-bottom:4px}
.scs{display:flex;gap:8px;flex-wrap:wrap}
.chip{border-radius:999px;padding:1px 11px;font-size:.85rem;background:var(--bg);border:1px solid var(--line);color:var(--muted)}
.chip b{color:hsl(var(--h) 85% 66%);font-size:1rem}
.row input[type=range]{max-width:200px;margin-top:6px}

input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:6px;border-radius:99px;background:rgba(255,255,255,.18);cursor:pointer;margin:6px 0}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;border-radius:50%;background:var(--accent);border:3px solid var(--bg)}
input[type=range]::-moz-range-thumb{width:14px;height:14px;border-radius:50%;background:var(--accent);border:3px solid var(--bg)}
.empty{color:var(--muted);text-align:center;padding:70px 0}.empty b{display:block;color:var(--text);font-size:1.5rem;font-weight:800;margin-bottom:4px}
.cats{display:flex;margin:0 0 18px;border:1px solid var(--line);border-radius:999px;overflow:hidden;background:var(--panel);width:100%;max-width:560px}
.cats button{flex:1;font:inherit;font-size:1rem;font-weight:600;color:var(--muted);background:none;border:0;padding:10px 12px;cursor:pointer;white-space:nowrap}
.cats button small{font-weight:400;opacity:.85;margin-left:6px}
.cats button.on{background:var(--accent);color:#2a1c00}
.cats button:hover:not(.on){color:var(--text)}
.pbar{height:8px;border-radius:99px;background:rgba(255,255,255,.16);overflow:hidden}
.pbar i{display:block;height:100%;background:var(--accent);border-radius:99px}
.pg{display:flex;gap:12px;align-items:center;margin:2px 0 8px;font-size:.88rem;color:var(--muted)}
.pg .pbar{flex:1;max-width:260px}
.minilab{display:block;color:var(--muted);font-size:.8rem;margin-top:6px}
.wact{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.wact button,.dback button,.step button,.lnk{font:inherit;font-size:.85rem;color:var(--text);background:var(--bg);border:1px solid var(--line);border-radius:999px;padding:5px 14px;cursor:pointer}
.wact button:hover,.dback button:hover,.step button:hover,.lnk:hover{border-color:var(--accent)}
.wact .pri{background:var(--accent);color:#2a1c00;border-color:var(--accent);font-weight:600}
.dback{margin-bottom:14px}
.lnk{margin-top:12px}
.hero .seg{display:inline-flex;margin:0 0 14px}
.hero .seg button{font:inherit;font-size:.9rem;color:var(--muted);background:var(--panel);border:0;border-radius:0;padding:7px 18px;cursor:pointer}
.hero .seg button.on{background:var(--accent);color:#2a1c00;font-weight:600}
.step{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:6px 0 10px;color:var(--muted)}
.step button{width:38px;height:38px;padding:0;font-size:1.25rem;border-radius:50%}
.step input[type=number]{width:78px;font:inherit;font-size:1.05rem;font-weight:600;color:var(--text);background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:7px 10px}
.fin{margin-top:16px}.fin .lab{color:var(--muted);font-size:.9rem;margin-right:8px}
.fin .eo{font-weight:800;font-size:1.3rem;color:hsl(var(--h) 85% 66%)}.fin .eo.none{color:var(--muted)}
.elist{display:grid;gap:8px}
.erow{display:flex;align-items:center;gap:12px;flex-wrap:wrap;background:var(--panel);border-radius:12px;padding:8px 14px}
.erow .ek{min-width:80px;font-weight:600}
.erow input[type=range]{flex:1;min-width:140px;max-width:260px;margin:0}
.erow .eo{min-width:2ch;font-weight:800;color:hsl(var(--h) 85% 66%)}.erow .eo.none{color:var(--muted)}
button:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
@media (max-width:620px){.hero{flex-direction:column;align-items:flex-start}.hero .poster{flex-basis:auto;width:150px}}
@media (max-width:620px){
  body{padding:calc(20px + env(safe-area-inset-top)) max(14px,env(safe-area-inset-right)) calc(70px + env(safe-area-inset-bottom)) max(14px,env(safe-area-inset-left))}
  input,textarea,select{font-size:16px!important}
  .cats button{padding:12px 6px;font-size:.92rem}.cats button small{display:block;margin:0}
  .bar{flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;margin-right:-14px;padding-right:14px}
  .bar::-webkit-scrollbar{display:none}.bar>*{flex:0 0 auto;white-space:nowrap}
  .row{flex-wrap:wrap}.row .wact{width:100%}
  .wact button,.tools button{min-height:40px}
  .erow input[type=range]{max-width:none}
  input[type=range]{height:10px}
  input[type=range]::-webkit-slider-thumb{width:28px;height:28px}
  input[type=range]::-moz-range-thumb{width:22px;height:22px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<main>
  <header>
    <h1>Meine Anime-Listen</h1>
    <p class="stats" id="stats"></p>
    <p class="sync" id="sync"></p>
    <div class="themes" id="themes" aria-label="Farbschema">
      <button data-t="" style="--c:#ffb347" title="Bernstein"></button>
      <button data-t="sakura" style="--c:#ff7eb6" title="Sakura"></button>
      <button data-t="mint" style="--c:#5eead4" title="Mint"></button>
    </div>
  </header>

  <nav class="cats" id="cats" aria-label="Kategorien"></nav>
  <nav class="tabs" id="tabs" aria-label="Listen"></nav>

  <div class="search" id="searchbox">
    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
    <input id="q" type="search" placeholder="Anime suchen, z. B. Frieren" autocomplete="off" aria-label="Anime suchen">
    <div class="sug" id="sug"></div>
  </div>
  <div class="hint" id="hint"></div>

  <div class="bar" id="bar"></div>
  <div class="panel" id="panel" hidden></div>
  <div id="out"></div>
</main>
<script>
const KEY = 'anime-lists-v3';
const $ = id => document.getElementById(id);
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const uid = () => Math.random().toString(36).slice(2, 8) + Date.now().toString(36).slice(-4);
const now = () => Date.now();
const norm = s => String(s).toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '');
const hint = t => { $('hint').textContent = t; };
const fmt = n => (Math.round(n * 10) / 10).toString().replace('.', ',');
const hue = s => s ? Math.round((s - 1) / 9 * 130 + 5) : 0;
const safeId = v => String(v).replace(/[^\w.~+@:-]/g, '_');

/* ---------- Daten ---------- */
function newList(name) { return { lid: uid(), name, key: null, nts: now(), items: {}, scores: {}, alts: {}, last: 0 }; }
function fromOld(name, arr, me) {
  const L = newList(name);
  for (const a of arr) {
    if (!a || !a.title) continue;
    const aid = safeId(a.id != null ? a.id : uid());
    L.items[aid] = { t: a.title, i: a.img || '', ts: now() };
    if (a.alts && a.alts.length) L.alts[aid] = a.alts.map(x => ({ t: x.title, i: x.img }));
    if (a.score) { (L.scores[me.id] = L.scores[me.id] || { n: me.name, s: {} }).s[aid] = [a.score, now()]; }
  }
  return L;
}
function load() {
  try { const d = JSON.parse(localStorage.getItem(KEY)); if (d && d.lists && d.lists.length && d.me) return d; } catch (e) {}
  const me = { id: 'p' + uid(), name: '' }, lists = [];
  try {
    const o = JSON.parse(localStorage.getItem('anime-lists-v2'));
    if (o && o.lists) { if (o.me) me.name = o.me; for (const l of o.lists) if (!l.owner) lists.push(fromOld(l.name, l.items || [], me)); }
  } catch (e) {}
  if (!lists.length) {
    try { const old = JSON.parse(localStorage.getItem('anime-liste-v1')); if (Array.isArray(old) && old.length) lists.push(fromOld('Meine Liste', old, me)); } catch (e) {}
  }
  if (!lists.length) lists.push(newList('Meine Liste'));
  return { me, lists, active: lists[0].lid, gsUrl: '' };
}
let db = load();
db.gsUrl = db.gsUrl || '';
db.cat = ['list', 'watch', 'done'].includes(db.cat) ? db.cat : 'list';
const save = () => { try { localStorage.setItem(KEY, JSON.stringify(db)); } catch (e) {} };
const cur = () => db.lists.find(l => l.lid === db.active) || db.lists[0];
const live = L => Object.entries(L.items).filter(([, x]) => !x.d).map(([aid, x]) => ({ aid, ...x }));
const scoreOf = (L, pid, aid) => { const e = L.scores[pid], v = e && e.s[aid]; return v && v[0] > 0 ? v[0] : null; };
const myScore = (L, aid) => scoreOf(L, db.me.id, aid);
const pname = (L, pid) => pid === db.me.id ? 'Du' : ((L.scores[pid] && L.scores[pid].n) || 'Person');
const others = L => Object.keys(L.scores).filter(p => p !== db.me.id && Object.values(L.scores[p].s).some(v => v[0] > 0));
const parts = L => [db.me.id, ...others(L)];
const stOf = x => x.st === 'w' || x.st === 'd' ? x.st : 't';
const liveIn = (L, st) => live(L).filter(x => stOf(x) === st);
function epStats(L, pid, aid) {
  const e = L.scores[pid]; if (!e) return null;
  const pre = `e:${aid}#`; let n = 0, sum = 0;
  for (const [k, v] of Object.entries(e.s)) if (k.startsWith(pre) && v[0] > 0) { n++; sum += v[0]; }
  return n ? { n, avg: sum / n } : null;
}
