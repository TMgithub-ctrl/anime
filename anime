      <label>Deine Sicherung (Code)<textarea id="pBak" rows="3" readonly>${esc(encBackup())}</textarea></label>
      <div class="row2"><button class="go" data-pa="bakcopy">Code kopieren</button><button data-pa="baksave">Als Datei speichern</button></div>
      <p style="margin-top:18px">Sicherung einspielen: Code einfügen oder Datei wählen. Vorhandene Daten bleiben erhalten und werden zusammengeführt.</p>
      <textarea id="pBakIn" rows="3" placeholder="ANIMEBACKUP:…"></textarea>
      <div class="row2"><input type="file" id="pBakFile" accept=".json,.txt"><button class="go" data-pa="bakload">Einspielen</button></div>`;
  } else if (panel === 'new') {
    h = `<label>Name der neuen Liste<input type="text" id="pName2" maxlength="40" placeholder="z. B. Winter-Season"></label>
      <div class="row2"><button class="go" data-pa="create">Liste anlegen</button><button data-pa="close">Abbrechen</button></div>`;
  } else if (panel === 'ren') {
    h = `<label>Neuer Name<input type="text" id="pName2" maxlength="40" value="${esc(L.name)}"></label>
      <div class="row2"><button class="go" data-pa="rename">Speichern</button><button data-pa="close">Abbrechen</button></div>`;
  } else if (panel === 'del') {
    h = `<p>Liste „${esc(L.name)}“ von diesem Gerät löschen?${L.key ? ' Die Online-Daten bleiben für deinen Kollegen bestehen.' : ' Das lässt sich nicht rückgängig machen.'}</p>
      <div class="row2"><button class="go" data-pa="delete">Ja, löschen</button><button data-pa="close">Abbrechen</button></div>`;
  }
  P.innerHTML = h + '<div class="msg" id="pMsg"></div>';
  const f = P.querySelector('#pName2,#pTxt'); if (f) f.focus();
}
$('panel').addEventListener('keydown', e => {
  if (e.key === 'Enter' && e.target.tagName === 'INPUT' && e.target.type === 'text') { e.preventDefault(); const g = $('panel').querySelector('.go'); if (g) g.click(); }
});
$('panel').addEventListener('change', e => {
  const to = { pFile: 'pTxt', pBakFile: 'pBakIn' }[e.target.id];
  if (to) { const f = e.target.files[0]; if (f) f.text().then(t => { $(to).value = t; }); }
});
$('panel').addEventListener('click', async e => {
  const b = e.target.closest('button'); if (!b || !b.dataset.pa) return;
  const L = cur(), a = b.dataset.pa;
  const takeName = () => { const n = ($('pName') || {}).value; if (n && n.trim()) { db.me.name = n.trim().slice(0, 30); const en = L.scores[db.me.id]; if (en) en.n = db.me.name; save(); } return db.me.name; };
  if (a === 'close') { panel = null; renderPanel(); return; }
  if (a === 'create') {
    const n = $('pName2').value.trim(); if (!n) { msg('Gib der Liste einen Namen.', true); return; }
    const nl = newList(n); db.lists.push(nl); db.active = nl.lid; panel = null; view = 'mine'; save(); renderPanel(); render(); return;
  }
  if (a === 'rename') {
    const n = $('pName2').value.trim(); if (!n) { msg('Gib der Liste einen Namen.', true); return; }
    L.name = n; L.nts = now(); touch(L); panel = null; renderPanel(); render(); return;
  }
  if (a === 'delete') {
    db.lists = db.lists.filter(x => x !== L);
    if (!db.lists.length) db.lists.push(newList('Meine Liste'));
    db.active = db.lists[0].lid; panel = null; save(); renderPanel(); render(); return;
  }
  if (a === 'bakcopy') {
    const t = $('pBak'); t.select();
    try { await navigator.clipboard.writeText(t.value); msg('Sicherung kopiert. Bewahre sie gut auf.'); }
    catch (err) { document.execCommand('copy'); msg('Sicherung markiert. Mit Strg+C kopieren.'); }
    return;
  }
  if (a === 'baksave') {
    const blob = new Blob([JSON.stringify(makeBackup(), null, 1)], { type: 'application/json' });
    const el = document.createElement('a');
    el.href = URL.createObjectURL(blob); el.download = 'anime-sicherung-' + new Date().toISOString().slice(0, 10) + '.json'; el.click();
    setTimeout(() => URL.revokeObjectURL(el.href), 1000);
    msg('Datei gespeichert (Downloads-Ordner).'); return;
  }
  if (a === 'bakload') {
    const t = ($('pBakIn').value || '').trim(); if (!t) { msg('Nichts eingefügt.', true); return; }
    try {
      const r = restoreBackup(parseBackup(t));
      panel = null; renderPanel(); render();
      hint(`Sicherung eingespielt: ${r.added} Liste(n) neu, ${r.merged} zusammengeführt.`);
    } catch (err) { msg(err.message && err.message.startsWith('Das ist') ? err.message : 'Die Sicherung ist ungültig oder unvollständig.', true); }
    return;
  }
  if (a === 'gscopy') {
    const t = $('pGsCode'); t.select();
    try { await navigator.clipboard.writeText(t.value); msg('Script kopiert.'); }
    catch (err) { document.execCommand('copy'); msg('Script markiert. Mit Strg+C kopieren.'); }
    return;
  }
  if (a === 'gssave') {
    const v = ($('pGs').value || '').trim();
    if (!GS_RE.test(v)) { msg('Das ist keine Web-App-URL. Sie muss …/macros/s/…/exec enthalten.', true); return; }
    db.gsUrl = v; save(); msg('Gespeichert. Klicke jetzt auf „Verbindung testen“.'); return;
  }
  if (a === 'test') {
    msg('Teste die Online-Speicher …'); $('pLog').textContent = '';
    const out = await testBackends(); $('pLog').textContent = out.join('\n'); msg(''); return;
  }
  if (a === 'copy') {
    const t = $('pCode'); t.select();
    try { await navigator.clipboard.writeText(t.value); msg('Code kopiert. Schick ihn deinem Kollegen.'); }
    catch (err) { document.execCommand('copy'); msg('Code markiert. Mit Strg+C kopieren.'); }
    return;
  }
  if (a === 'now') { takeName(); touch(L); await syncList(L); msg(SY.get(L.lid) && SY.get(L.lid).err ? SY.get(L.lid).err : 'Abgeglichen.', !!(SY.get(L.lid) && SY.get(L.lid).err)); return; }
  if (a === 'stop') {
    if (!b.dataset.arm) { b.dataset.arm = 1; b.textContent = 'Wirklich beenden?'; return; }
    L.key = null; L.last = 0; save(); panel = 'share'; renderPanel(); render(); return;
  }
  if (a === 'start') {
    const nm = takeName(); if (!nm) { msg('Trag zuerst deinen Namen ein.', true); return; }
    msg('Lege Online-Speicher an …');
    const errs = [];
    for (const k of Object.keys(BK)) {
      if (k === 'gs' && !gsDep()) continue;
      try {
        const e0 = L.scores[db.me.id] || (L.scores[db.me.id] = { n: nm, s: {} }); e0.n = nm;
        const key = await bCreate(k, pub(L));
        await bGet(key);
        L.key = key; break;
      } catch (err) { errs.push(err.message); }
    }
    if (!L.key) {
      msg(errs.join('  |  ') + (gsDep() ? '' : '  |  Tipp: Richte unten den eigenen Google-Speicher ein.'), true);
      const d = $('gsd'); if (d) d.open = true;
      return;
    }
    L.last = now(); save(); panel = 'share'; renderPanel(); render(); syncList(L); return;
  }
  if (a === 'import') {
    const t = ($('pTxt').value || '').trim(); if (!t) { msg('Nichts eingefügt.', true); return; }
    const key = parseKey(t);
    if (key) { await joinCode(key, takeName()); return; }
    const entries = parseImport(t);
    if (!entries.length) { msg('Nichts zum Importieren gefunden.', true); return; }
    panel = null; renderPanel(); runImport(entries);
  }
});

async function joinCode(key, nm) {
  const ex = db.lists.find(l => l.key === key);
  if (ex) { db.active = ex.lid; panel = null; renderPanel(); render(); syncList(ex); hint('Diese Liste hast du schon.'); return; }
  if (!nm) { msg('Trag deinen Namen ein, damit dein Kollege deine Scores erkennt.', true); return; }
  msg('Lade Liste …');
  try {
    const R = await bGet(key);
    const L = newList(R.name || 'Gemeinsame Liste');
    L.key = key; L.items = R.items || {}; L.scores = R.scores || {}; L.nts = R.nts || 0; L.last = now();
    L.scores[db.me.id] = L.scores[db.me.id] || { n: nm, s: {} }; L.scores[db.me.id].n = nm;
    db.lists.push(L); db.active = L.lid; view = 'mine'; panel = null; save(); renderPanel(); render();
    queueSync(L, 300);
    hint(`Du bist der Liste „${L.name}“ beigetreten.`);
  } catch (err) { msg(err.message, true); }
}

/* ---------- Import von Titeln ---------- */
const fixScore = v => {
  if (v == null || v === '') return null;
  let n = parseFloat(String(v).replace(',', '.'));
  if (!n) return null;
  if (n > 10) n = n / 10;
  return Math.min(10, Math.max(1, Math.round(n)));
};
function parseImport(text) {
  text = text.trim();
  if (!text) return [];
  if (/^[\[{]/.test(text)) {
    try {
      let d = JSON.parse(text);
      if (!Array.isArray(d)) d = d.list || d.animes || d.items || [];
      return d.map(x => typeof x === 'string' ? { title: x } : {
        title: x.title || x.t || x.name || x.anime || x.series_title, score: fixScore(x.score ?? x.rating ?? x.my_score),
        img: x.img || x.image, id: x.id }).filter(x => x.title);
    } catch (e) {}
  }
  return text.split(/\r?\n/).map(l => l.trim()).filter(l => l && !/^(title|titel|name|anime)\s*[;,\t]/i.test(l)).map(l => {
    const m = l.match(/^(.*?)\s*[;\t|,]\s*(\d+(?:[.,]\d+)?)\s*$/);
    const clean = t => t.replace(/^(?:[-*•]|\d+[.)])\s+/, '').replace(/^"|"$/g, '').trim();
    return m ? { title: clean(m[1]), score: fixScore(m[2]) } : { title: clean(l) };
  }).filter(x => x.title);
}
let busy = false;
async function runImport(entries) {
  if (busy) return;
  busy = true;
  const L = cur();
  let added = 0, n = 0;
  for (const e of entries) {
    n++;
    hint(`Importiere ${n}/${entries.length}: ${e.title}`);
    if (live(L).some(x => norm(x.t) === norm(e.title))) continue;
    let aid, t = e.title, i = e.img || '', alts = [], n = null;
    if (e.img) aid = safeId(e.id != null ? e.id : 'i' + now() + n);
    else {
      let res = [];
      try { res = await search(e.title); } catch (err) {}
      const r = res[0] || { id: 'm' + now() + n, title: e.title, img: '' };
      aid = safeId(r.id); t = r.title; i = r.img; n = r.episodes || null;
      alts = res.filter(x => x.id !== r.id).map(x => ({ t: x.title, i: x.img }));
      await new Promise(ok => setTimeout(ok, 700));
    }
    if (live(L).some(x => x.aid === aid)) continue;
    L.items[aid] = { t, i, ts: now(), ...(n ? { n } : {}) }; L.alts[aid] = alts;
    if (e.score) setScore(L, aid, e.score); else touch(L);
    added++;
    if (cur() === L) safeRender();
  }
  busy = false;
  hint(`Import fertig: ${added} von ${entries.length} hinzugefügt.`);
}

/* ---------- Farbschema ---------- */
const applyTheme = t => {
  if (t) document.documentElement.dataset.theme = t; else delete document.documentElement.dataset.theme;
  document.querySelectorAll('#themes button').forEach(b => b.classList.toggle('on', b.dataset.t === (t || '')));
};
let theme = '';
try { theme = localStorage.getItem('anime-theme') || ''; } catch (e) {}
applyTheme(theme);
$('themes').onclick = e => {
  const b = e.target.closest('button'); if (!b) return;
  applyTheme(b.dataset.t);
  try { localStorage.setItem('anime-theme', b.dataset.t); } catch (e) {}
};

save();
render();
db.lists.filter(l => l.key).forEach((l, i) => setTimeout(() => syncList(l), 300 + i * 600));
</script>
