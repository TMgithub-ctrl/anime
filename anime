        <div class="pg">${total ? `<div class="pbar"><i style="width:${pct}%"></i></div>` : ''}<span>Folge ${ep}${total ? ` von ${total}` : ''}</span></div>
        <div class="scs">${chip('Du', my)}${P.filter(p => p !== me).map(p => chip(pname(L, p), scoreOf(L, p, `e:${a.aid}#${ep}`))).join('')}</div>
        <span class="minilab">Folge ${ep} bewerten</span>${rng(my, 'e', ep, `Deine Bewertung für Folge ${ep}`)}
      </div>
      <div class="wact"><button data-act="ep-" aria-label="Eine Folge zurück">−</button><button class="pri" data-act="ep+">${total && ep >= total ? 'Fertig geguckt' : 'Nächste Folge'}</button><button data-act="detail">Details</button><button data-act="done">Geguckt</button><button data-act="todo">Zur Liste</button></div>
    </article>`;
  }).join('')}</div>`;
}

function renderDone(L) {
  const P = parts(L), me = db.me.id;
  let sel = (cmp.sel || P).filter(p => P.includes(p)); if (!sel.length) sel = P;
  const names = sel.map(p => pname(L, p));
  const it = liveIn(L, 'd').map(a => {
    const sc = sel.map(p => scoreOf(L, p, 'r:' + a.aid)), av = sc.filter(Boolean);
    return { ...a, sc, cnt: av.length, c: av.length ? av.reduce((x, y) => x + y, 0) / av.length : null, ea: epStats(L, me, a.aid), mine: scoreOf(L, me, 'r:' + a.aid) };
  });
  const ranked = it.filter(r => r.c != null).sort((a, b) => b.c - a.c || b.cnt - a.cnt || a.t.localeCompare(b.t));
  const open = it.filter(r => r.c == null).sort((a, b) => a.t.localeCompare(b.t));
  $('stats').textContent = it.length ? `${it.length} geguckt · ${ranked.length} bewertet` : 'Noch nichts geguckt.';
  if (!it.length) { $('out').innerHTML = '<div class="empty"><b>Noch keine Bewertungen</b>Markiere in der Liste oder unter „Am Schauen“ einen Anime als geguckt.</div>'; return; }
  const epChip = r => r.ea ? `<span class="chip" style="--h:${hue(r.ea.avg)}">Ø deiner Folgen <b>${fmt(r.ea.avg)}</b></span>` : '';
  const rowH = (r, rank) => `<article class="row" data-aid="${esc(r.aid)}" style="--h:${hue(r.c)}">
    ${rank ? `<span class="rk">#${rank}</span>` : ''}
    <div class="pst">${imgOf(r)}</div>
    <div class="mid"><div class="nm">${esc(r.t)}</div>
      <div class="scs">${sel.map((p, i) => chip(names[i], r.sc[i])).join('')}${epChip(r)}</div>
      ${sel.includes(me) ? `<span class="minilab">Deine Gesamtbewertung</span>${rng(r.mine, 'r', 0, 'Deine Gesamtbewertung für ' + r.t)}` : ''}
    </div>
    ${r.c != null ? ringC(r.c, 'sm') : ''}
    <div class="wact"><button data-act="detail">Details</button><button data-act="watch">Weiter schauen</button><button data-act="todo">Zur Liste</button></div>
  </article>`;
  const section = (title, list, start) => list.length ? `<h3>${title}</h3><div class="rows">${list.map((r, i) => rowH(r, start ? i + start : 0)).join('')}</div>` : '';
  let h = P.length > 1 ? `<div class="ctl"><span class="lab">Anzeigen:</span><div class="who">${P.map(p => `<button data-p="${esc(p)}" class="${sel.includes(p) ? 'on' : ''}">${esc(pname(L, p))}</button>`).join('')}</div></div><p class="note">Die Reihenfolge richtet sich nach dem Durchschnitt der Gesamtbewertungen der Gewählten.</p>` : '';
  if (ranked.length) {
    const t = ranked[0];
    h += `<section class="hero" data-aid="${esc(t.aid)}" style="--h:${hue(t.c)};--art:url('${esc(t.i)}')">
      <div class="poster">${poster(t)}</div>
      <div class="txt"><span class="flag">Am besten bewertet</span><h2>${esc(t.t)}</h2>
        <div class="scs">${sel.map((p, i) => chip(names[i], t.sc[i])).join('')}${epChip(t)}</div>
        <div class="srow">${ringC(t.c)}<div class="wact"><button data-act="detail">Details</button></div></div></div></section>`;
    h += section('Eure Bewertungen', ranked.slice(1), 2);
  }
  h += section('Noch nicht bewertet', open);
  $('out').innerHTML = h;
}

function renderDetail(L, aid) {
  const x = L.items[aid], st = stOf(x), P = parts(L), me = db.me.id, a = { aid, ...x };
  const total = x.n || 0, ep = x.ep || 0, pct = total ? Math.min(100, Math.round(ep / total * 100)) : 0;
  const stBtn = (v, l) => `<button data-act="st" data-st="${v}" class="${st === v ? 'on' : ''}">${l}</button>`;
  const my = scoreOf(L, me, 'r:' + aid), es = epStats(L, me, aid);
  $('stats').textContent = x.t;
  const from = detailAll ? 1 : Math.max(1, ep - 19);
  let rows = '';
  for (let k = ep; k >= from; k--) {
    const mk = scoreOf(L, me, `e:${aid}#${k}`);
    const vals = P.map(p => scoreOf(L, p, `e:${aid}#${k}`)).filter(Boolean), avg = vals.length > 1 ? vals.reduce((s2, v) => s2 + v, 0) / vals.length : null;
    rows += `<div class="erow" data-aid="${esc(aid)}" style="--h:${hue(mk)}"><span class="ek">Folge ${k}</span>${rng(mk, 'e', k, `Deine Bewertung für Folge ${k}`)}<output class="eo ${mk ? '' : 'none'}">${mk || '–'}</output>
      <span class="scs">${P.filter(p => p !== me).map(p => chip(pname(L, p), scoreOf(L, p, `e:${aid}#${k}`))).join('')}${avg ? `<span class="chip" style="--h:${hue(avg)}">Ø <b>${fmt(avg)}</b></span>` : ''}</span></div>`;
  }
  const more = ep > 20 ? `<button class="lnk" data-act="showall">${detailAll ? 'Nur die letzten 20 zeigen' : `Alle ${ep} Folgen anzeigen`}</button>` : '';
  $('out').innerHTML = `<div class="dback"><button data-act="back">← Zurück</button></div>
  <section class="hero" data-aid="${esc(aid)}" style="--h:${hue(my)};--art:url('${esc(x.i)}')">
    <div class="poster">${poster(a)}</div>
    <div class="txt">
      <span class="flag">${{ t: 'In der Liste', w: 'Am Schauen', d: 'Geguckt' }[st]}</span>
      <h2>${esc(x.t)}</h2>
      <div class="seg" role="group" aria-label="Status">${stBtn('t', 'Liste')}${stBtn('w', 'Am Schauen')}${stBtn('d', 'Geguckt')}</div>
      <div class="step"><span>Folge</span><button data-act="ep-" aria-label="Eine Folge zurück">−</button><input type="number" id="epIn" min="0" ${total ? `max="${total}"` : ''} value="${ep}" aria-label="Aktuelle Folge"><button data-act="ep+" aria-label="Nächste Folge">+</button><span>von</span><input type="number" id="nTot" min="1" value="${total || ''}" placeholder="?" aria-label="Folgen insgesamt"></div>
      ${total ? `<div class="pg"><div class="pbar"><i style="width:${pct}%"></i></div><span>${pct} %</span></div>` : ''}
      ${st === 'd' ? `<div class="fin"><span class="lab">Deine Gesamtbewertung</span><output class="eo ${my ? '' : 'none'}">${my || '–'}</output>${rng(my, 'r', 0, 'Deine Gesamtbewertung')}
        <div class="scs">${P.filter(p => p !== me).map(p => chip(pname(L, p), scoreOf(L, p, 'r:' + aid))).join('')}${es ? `<span class="chip" style="--h:${hue(es.avg)}">Ø deiner Folgen <b>${fmt(es.avg)}</b></span>` : ''}</div></div>` : ''}
    </div>
  </section>
  <h3>Folgen bewerten</h3>
  ${ep ? `<div class="elist">${rows}</div>${more}` : '<p class="note">Setze oben die aktuelle Folge, dann kannst du die Folgen bewerten.</p>'}`;
}

/* ---------- Bedienung ---------- */
$('tabs').onclick = e => {
  const b = e.target.closest('button'); if (!b) return;
  if (b.dataset.l === '+') { panel = 'new'; renderPanel(); return; }
  db.active = b.dataset.l; panel = null; detail = null; hint(''); save(); renderPanel(); render();
  const L = cur(); if (L.key) syncList(L);
};
$('cats').onclick = e => {
  const b = e.target.closest('button'); if (!b) return;
  db.cat = b.dataset.c; detail = null; save(); render();
};
$('bar').onclick = e => {
  const b = e.target.closest('button'); if (!b) return;
  if (b.dataset.v) { view = b.dataset.v; render(); return; }
  const a = b.dataset.a;
  panel = panel === a ? null : a; renderPanel();
};
$('out').addEventListener('input', e => {
  if (e.target.type !== 'range') return;
  lastIn = now();
  const box = e.target.closest('[data-aid]'), o = box.querySelector('output');
  if (o) { o.textContent = e.target.value; o.classList.remove('none'); }
  box.style.setProperty('--h', hue(+e.target.value));
  box.style.setProperty('--s', e.target.value);
});
$('out').addEventListener('change', e => {
  const t = e.target, L = cur(), box = t.closest('[data-aid]');
  if (!box) return;
  const aid = box.dataset.aid;
  if (t.type === 'range') {
    lastIn = 0;
    const k = t.dataset.k || 's';
    setScore(L, k === 'r' ? 'r:' + aid : k === 'e' ? `e:${aid}#${t.dataset.ek}` : aid, +t.value);
    render(); return;
  }
  if (t.id === 'epIn' || t.id === 'nTot') {
    const x = L.items[aid]; if (!x) return;
    const v = Math.max(0, Math.floor(+t.value || 0));
    if (t.id === 'epIn') setEp(L, aid, x.n ? Math.min(v, x.n) : v);
    else { L.items[aid] = { ...x, n: v || null, ts: now() }; touch(L); }
    render();
  }
});
$('out').addEventListener('click', e => {
  const b = e.target.closest('button'); if (!b) return;
  const L = cur();
  if (b.dataset.m) { cmp.mode = b.dataset.m; render(); return; }
  if (b.dataset.p) {
    const P = parts(L), s = new Set(cmp.sel || P);
    if (s.has(b.dataset.p)) s.delete(b.dataset.p); else s.add(b.dataset.p);
    cmp.sel = s.size ? [...s] : P; render(); return;
  }
  if (b.dataset.act === 'back') { detail = null; detailAll = false; render(); return; }
  if (b.dataset.act === 'showall') { detailAll = !detailAll; render(); return; }
  const box = b.closest('[data-aid]'); if (!box) return;
  const aid = box.dataset.aid, x = L.items[aid]; if (!x) return;
  const act = b.dataset.act;
  if (act === 'watch' || act === 'done' || act === 'todo' || act === 'st') {
    const to = act === 'st' ? b.dataset.st : act === 'watch' ? 'w' : act === 'done' ? 'd' : 't';
    moveTo(L, aid, to);
    hint(`„${x.t}“ ist jetzt ${to === 'w' ? 'unter „Am Schauen“' : to === 'd' ? 'unter „Bewertungen“' : 'wieder in der Liste'}.`);
    render(); return;
  }
  if (act === 'detail') { detail = aid; detailAll = false; render(); window.scrollTo(0, 0); return; }
  if (act === 'ep+') {
    if (x.n && (x.ep || 0) >= x.n) { moveTo(L, aid, 'd'); hint(`„${x.t}“ ist komplett geguckt und jetzt unter „Bewertungen“.`); }
    else setEp(L, aid, (x.ep || 0) + 1);
    render(); return;
  }
  if (act === 'ep-') { setEp(L, aid, Math.max(0, (x.ep || 0) - 1)); render(); return; }
  if (b.dataset.act === 'del') {
    if (!b.dataset.arm) {
      b.dataset.arm = 1; b.textContent = 'Sicher?';
      setTimeout(() => { if (b.isConnected) { delete b.dataset.arm; b.textContent = 'Entfernen'; } }, 3000);
      return;
    }
    L.items[aid] = { ...x, d: 1, ts: now() }; touch(L); render();
  }
  if (b.dataset.act === 'alt') {
    const al = L.alts[aid];
    if (al && al.length) {
      const n = al.shift(); al.push({ t: x.t, i: x.i });
      L.items[aid] = { ...x, t: n.t, i: n.i, ts: now() }; touch(L); render();
    }
  }
});

