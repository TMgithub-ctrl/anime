/* ---------- Kategorien: Am Schauen, Bewertungen, Details ---------- */
function moveTo(L, aid, st) {
  const x = L.items[aid]; if (!x) return;
  const y = { ...x, ts: now() };
  if (st === 't') delete y.st; else y.st = st;
  if (st === 'w' && !y.ep) y.ep = 1;
  if (st === 'd' && y.n) y.ep = y.n;
  L.items[aid] = y; touch(L);
}
function setEp(L, aid, v) { const x = L.items[aid]; if (!x) return; L.items[aid] = { ...x, ep: v, pts: now(), ts: now() }; touch(L); }
function renderCats() {
  const L = cur(), c = { list: 0, watch: 0, done: 0 };
  live(L).forEach(x => { const s = stOf(x); c[s === 't' ? 'list' : s === 'w' ? 'watch' : 'done']++; });
  $('cats').innerHTML = [['list', 'Liste'], ['watch', 'Am Schauen'], ['done', 'Bewertungen']].map(([k, l]) => `<button data-c="${k}" class="${db.cat === k ? 'on' : ''}">${l}<small>${c[k]}</small></button>`).join('');
}
const imgOf = a => a.i ? `<img src="${esc(a.i)}" alt="" loading="lazy">` : '';
const rng = (v, k, ek, label) => `<input type="range" min="1" max="10" step="1" value="${v || 5}" data-k="${k}" ${ek ? `data-ek="${ek}"` : ''} aria-label="${esc(label)}">`;

function renderWatching(L) {
  const it = liveIn(L, 'w').sort((a, b) => (b.pts || b.ts || 0) - (a.pts || a.ts || 0));
  $('stats').textContent = it.length ? `${it.length} ${it.length === 1 ? 'Anime' : 'Animes'} am Schauen` : 'Gerade schaut ihr nichts.';
  if (!it.length) { $('out').innerHTML = '<div class="empty"><b>Nichts am Schauen</b>Starte in der Liste einen Anime mit „Am Schauen“.</div>'; return; }
  const me = db.me.id, P = parts(L);
  $('out').innerHTML = `<div class="rows">${it.map(a => {
    const ep = a.ep || 1, total = a.n || 0, pct = total ? Math.min(100, Math.round(ep / total * 100)) : 0, my = scoreOf(L, me, `e:${a.aid}#${ep}`);
    return `<article class="row" data-aid="${esc(a.aid)}" style="--h:${hue(my)}">
      <div class="pst">${imgOf(a)}</div>
