        <div class="scs">${sel.map((p, i) => chip(names[i], t.sc[i])).join('')}</div>
        <div class="srow">${ringC(t.c)}</div></div></section>`;
    h += section('Eure Rangliste', both.slice(1), 2);
  } else {
    h += '<div class="empty"><b>Noch keine gemeinsamen Scores</b>Sobald alle Gewählten einen Titel bewertet haben, erscheint er hier.</div>';
  }
  h += section('Es fehlen noch Scores', miss);
  $('out').innerHTML = h;
}

