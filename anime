    ${r.full ? ringC(r.c, 'sm') : ''}
  </article>`;
  const section = (title, list, start) => list.length ? `<h3>${title}</h3><div class="rows">${list.map((r, i) => rowH(r, start ? i + start : 0)).join('')}</div>` : '';

  $('stats').textContent = `${names.join(' × ')} · ${both.length} gemeinsam bewertet`;
  let h = `<div class="ctl"><span class="lab">Vergleichen:</span><div class="who">${P.map(p => `<button data-p="${esc(p)}" class="${sel.includes(p) ? 'on' : ''}">${esc(pname(L, p))}</button>`).join('')}</div>
    <div class="seg" role="group" aria-label="Berechnung"><button data-m="avg" class="${cmp.mode === 'avg' ? 'on' : ''}">Ø aller</button><button data-m="min" class="${cmp.mode === 'min' ? 'on' : ''}">Minimum</button></div></div>
  <p class="note">${cmp.mode === 'avg' ? 'Der Durchschnitt aller Gewählten bestimmt die Reihenfolge.' : 'Der niedrigste Score zählt: Oben landet nur, was alle mögen.'} Mit den Reglern änderst du direkt deine eigenen Scores.${P.length < 2 ? ' Noch hat niemand sonst Scores in dieser Liste. Über „Online-Sync“ lädst du deinen Kollegen ein.' : ''}</p>`;
  if (both.length) {
    const t = both[0];
    h += `<section class="hero" style="--h:${hue(t.c)};--art:url('${esc(t.i)}')">
      <div class="poster">${poster(t)}</div>
